{% comment %}
  Navy trust band after the hero. On the original this is FrontRow MD script-injected content
  (invisible in DOM dumps, renders on scroll) — rebuilt static, copy transplanted from the
  rendered page. "Learn more" is a stub span: the target is the app's modal.
{% endcomment %}

<section
  id="{{ section.settings.anchor_id | default: section.id }}"
  class="lp-clinicians-band"
>
  <p class="lp-clinicians-band__title">
    {% render 'lp-laurel', side: 'left' %}
    {% render 'lp-laurel', side: 'caduceus' %}
    <span>{{ section.settings.title | escape }}</span>
    {% render 'lp-laurel', side: 'right' %}
  </p>
  <p class="lp-clinicians-band__text">
    {%- if section.blocks.size > 0 -%}
      <span class="lp-clinicians-band__avatars" aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- if block.settings.photo != blank -%}
            {{ block.settings.photo | image_url: width: 96 | image_tag:
               class: 'lp-clinicians-band__avatar', widths: '48, 96', sizes: '26px',
               loading: 'lazy', alt: '' }}
          {%- endif -%}
        {%- endfor -%}
      </span>
    {%- endif -%}
    <strong>{{ section.settings.text_bold | escape }}</strong>{{ section.settings.text | escape }}
    <a class="lp-clinicians-band__more" href="{{ section.settings.more_link | default: '#clinician-reviews' }}">{{ section.settings.more_label | escape }}</a>
  </p>
</section>

<style>
  .lp-clinicians-band {
    padding: 32px 24px;
    background: #2c3e50;
    color: #fff;
    text-align: center;
  }

  .lp-clinicians-band__title {
    margin: 0 0 6px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.5rem;
    letter-spacing: 0.04em;
  }

  .lp-clinicians-band__avatars {
    display: inline-flex;
    align-items: center;
    vertical-align: -0.55em;
    margin-right: 8px;
  }

  .lp-clinicians-band__avatar {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #2c3e50;
  }

  .lp-clinicians-band__avatar + .lp-clinicians-band__avatar {
    margin-left: -8px;
  }

  .lp-clinicians-band__text {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.5;
    opacity: 0.95;
  }

  .lp-clinicians-band__more {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>

{% schema %}
{
  "name": "LP clinicians band",
  "tag": "section",
  "class": "section-lp-clinicians-band",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Clinicians' Choice"
    },
    {
      "type": "text",
      "id": "text_bold",
      "label": "Bold lead",
      "default": "472 clinicians"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": ", including OB/GYNs, share First Day on FrontrowMD without compensation."
    },
    {
      "type": "text",
      "id": "more_link",
      "label": "Learn more link",
      "info": "The original opens the review app's modal; here it anchors to the clinician evaluations on this page",
      "default": "#clinician-reviews"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "More label (stub)",
      "default": "Learn more"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets other sections link here, e.g. a CTA pointing at #standalone-product-section. Leave empty unless something links to this section."
    }
  ],
  "presets": [
    {
      "name": "LP clinicians band"
    }
  ],
  "enabled_on": {
    "templates": [
      "page",
      "index",
      "product"
    ]
  },
  "blocks": [
    {
      "type": "avatar",
      "name": "Clinician photo",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo"
        }
      ]
    }
  ]
}
{% endschema %}
