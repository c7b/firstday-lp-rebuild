{{ 'lp-urgency-banner.css' | asset_url | stylesheet_tag }}

<section
  id="{{ section.settings.anchor_id | default: section.id }}"
  class="lp-urgency-banner__section"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="lp-urgency-banner__content">
    <div class="lp-urgency-banner__media">
      {% if section.settings.video_url != blank %}
        <video
          class="lp-urgency-banner__video"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          {% if section.settings.poster_url != blank %}poster="{{ section.settings.poster_url | escape }}"{% endif %}
        >
          <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
        </video>
      {% endif %}
    </div>

    <div class="lp-urgency-banner__panel">
      <div class="lp-urgency-banner__text rte">{{ section.settings.text }}</div>
      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <a class="lp-urgency-banner__cta" href="{{ section.settings.cta_link }}" data-lp-cta>
          {{- section.settings.cta_label | escape -}}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP urgency banner",
  "tag": "section",
  "class": "lp-urgency-banner__wrapper",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Notice",
      "info": "The notice is always displayed in bold.",
      "default": "<p><strong>🚨 Due to the high demand, August has a very high risk of selling out!</strong></p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Claim Yours Now!"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "CTA link (URL or #anchor)",
      "default": "#standalone-product-section",
      "info": "In-page anchor to the buy box by default"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "default": "https://cdn.shopify.com/videos/c/vp/2e7dd77535bb4f0d8a3ff1e42b3dcbe6/2e7dd77535bb4f0d8a3ff1e42b3dcbe6.HD-720p-4.5Mbps-90596307.mp4"
    },
    {
      "type": "text",
      "id": "poster_url",
      "label": "Video poster URL",
      "default": "https://cdn.shopify.com/s/files/1/0773/6511/7120/files/preview_images/2e7dd77535bb4f0d8a3ff1e42b3dcbe6.thumbnail.0000000000.jpg?v=1785730422"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets other sections link here, e.g. a CTA pointing at #standalone-product-section. Leave empty unless something links to this section."
    }
  ],
  "presets": [
    {
      "name": "LP urgency banner"
    }
  ],
  "enabled_on": {
    "templates": [
      "page",
      "index",
      "product"
    ]
  }
}
{% endschema %}
