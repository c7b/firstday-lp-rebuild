{{ 'lp-urgency-banner.css' | asset_url | stylesheet_tag }}

{% comment %}
  One rich-text field instead of the three-part before/highlight/after split it used to be:
  the operator writes the sentence the way they'd say it and bolds what should stand out,
  rather than reverse-engineering which of three boxes holds which words. The month is
  literal text, as in the original — PLAN.md notes the dynamic-month option that was
  deliberately not implemented, since copy changes are out of scope.
{% endcomment %}

<section
  id="{{ section.settings.anchor_id | default: section.id }}"
  class="lp-urgency-banner__section color-{{ section.settings.color_scheme }} gradient"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="lp-urgency-banner__content">
    <div class="lp-urgency-banner__text rte">{{ section.settings.text }}</div>
    {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
      <a class="lp-urgency-banner__cta" href="{{ section.settings.cta_link }}" data-lp-cta>
        {{- section.settings.cta_label | escape -}}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "LP urgency banner",
  "tag": "section",
  "class": "lp-urgency-banner__wrapper",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Notice",
      "info": "Bold the words that should stand out — the month, a deadline.",
      "default": "<p>🚨 Due to the high demand, <strong>July</strong> has a very high risk of selling out!</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Claim Yours Now!"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "CTA link (URL or #anchor)",
      "default": "#standalone-product-section",
      "info": "In-page anchor to the buy box by default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 12
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets other sections link here, e.g. a CTA pointing at #standalone-product-section. Leave empty unless something links to this section."
    }
  ],
  "presets": [
    {
      "name": "LP urgency banner"
    }
  ],
  "enabled_on": {
    "templates": [
      "page",
      "index",
      "product"
    ]
  }
}
{% endschema %}
