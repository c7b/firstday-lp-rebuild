{{ 'lp-clinician-reviews.css' | asset_url | stylesheet_tag }}

<section
  id="{{ section.settings.anchor_id | default: section.id }}"
  class="lp-clinician-reviews__section color-{{ section.settings.color_scheme }} gradient"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  {% assign has_app_block = false %}
  {% for block in section.blocks %}
    {% if block.type == '@app' %}
      {% assign has_app_block = true %}
    {% endif %}
  {% endfor %}
  <div class="lp-clinician-reviews__container page-width">
    {% if section.settings.heading != blank %}
      <p class="lp-clinician-reviews__eyebrow"><svg class="lp-laurel" viewBox="0 0 12 16" aria-hidden="true" focusable="false"><path d="M9.6 1c-2 .5-3.6 1.7-4.6 3.3C3.9 6 3.4 8 3.7 10c-.7-1-1.1-2.2-1.2-3.5-.7 1.5-.8 3-.3 4.5.5 1.5 1.5 2.7 2.9 3.5l.5.4.6-.9c-1-.6-1.8-1.4-2.3-2.4 1 .5 2 .7 3.1.6-1-.4-1.8-1-2.4-1.9 1 .2 2 .1 2.9-.3-1-.2-1.8-.6-2.5-1.3.9 0 1.8-.3 2.6-.8-.9-.1-1.7-.4-2.4-1 .9-.2 1.7-.6 2.3-1.2-.8 0-1.6-.2-2.3-.6.8-.4 1.5-.9 2-1.6-.7.2-1.5.2-2.2 0 .9-.7 2-1.2 3.1-1.3L9.6 1Z"/></svg>{{ section.settings.heading | escape }} <svg class="lp-laurel lp-laurel--right" viewBox="0 0 12 16" aria-hidden="true" focusable="false"><path d="M9.6 1c-2 .5-3.6 1.7-4.6 3.3C3.9 6 3.4 8 3.7 10c-.7-1-1.1-2.2-1.2-3.5-.7 1.5-.8 3-.3 4.5.5 1.5 1.5 2.7 2.9 3.5l.5.4.6-.9c-1-.6-1.8-1.4-2.3-2.4 1 .5 2 .7 3.1.6-1-.4-1.8-1-2.4-1.9 1 .2 2 .1 2.9-.3-1-.2-1.8-.6-2.5-1.3.9 0 1.8-.3 2.6-.8-.9-.1-1.7-.4-2.4-1 .9-.2 1.7-.6 2.3-1.2-.8 0-1.6-.2-2.3-.6.8-.4 1.5-.9 2-1.6-.7.2-1.5.2-2.2 0 .9-.7 2-1.2 3.1-1.3L9.6 1Z"/></svg></p>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <h2 class="lp-clinician-reviews__heading">{{ section.settings.subheading | escape }}</h2>
    {% endif %}

    {% if section.settings.intro != blank %}
      <div class="lp-clinician-reviews__intro rte">{{ section.settings.intro }}</div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="lp-clinician-reviews__cards">
        {% for block in section.blocks %}
          {% if block.type == 'clinician_card' %}
            <article class="lp-clinician-reviews__card" {{ block.shopify_attributes }}>
              <div class="lp-clinician-reviews__profile">
                {% if block.settings.avatar != blank %}
                  {{
                    block.settings.avatar
                    | image_url: width: 160
                    | image_tag:
                      widths: '80, 160',
                      sizes: '64px',
                      class: 'lp-clinician-reviews__avatar',
                      loading: 'lazy',
                      alt: block.settings.name
                  }}
                {% elsif block.settings.avatar_url != blank %}
                  <img class="lp-clinician-reviews__avatar" src="{{ block.settings.avatar_url | escape }}" alt="{{ block.settings.name | escape }}" width="64" height="64" loading="lazy">
                {% else %}
                  <span class="lp-clinician-reviews__avatar lp-clinician-reviews__avatar--placeholder" aria-hidden="true">MD</span>
                {% endif %}
                <header class="lp-clinician-reviews__card-header">
                  {% if block.settings.name != blank %}
                    <h3 class="lp-clinician-reviews__name">{{ block.settings.name | escape }}</h3>
                  {% endif %}
                  {% if block.settings.verified_label != blank %}
                    <p class="lp-clinician-reviews__verified">
                      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.8 12 3l2.3-.1 1 2.1 2 1.2-.1 2.3 1.2 2-1.2 2 .1 2.3-2 1.2-1 2.1-2.3-.1-2 1.2-2-1.2-2.3.1-1-2.1-2-1.2.1-2.3-1.2-2 1.2-2-.1-2.3 2-1.2 1-2.1L8 3l2-1.2Z" fill="currentColor"/><path d="m6.8 10.2 2 2 4.4-4.5" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>
                      {{ block.settings.verified_label | escape }}
                    </p>
                  {% endif %}
                </header>
              </div>

              <dl class="lp-clinician-reviews__meta">
                {% if block.settings.specialty != blank %}
                  <div class="lp-clinician-reviews__meta-row">
                    <dt>Specialty</dt>
                    <dd>{{ block.settings.specialty | escape }}</dd>
                  </div>
                {% endif %}
                {% if block.settings.years != blank %}
                  <div class="lp-clinician-reviews__meta-row">
                    <dt>Years in practice</dt>
                    <dd>{{ block.settings.years | escape }}</dd>
                  </div>
                {% endif %}
              </dl>

              {% if block.settings.title != blank %}
                <h4 class="lp-clinician-reviews__title">{{ block.settings.title | escape }}</h4>
              {% endif %}

              {% if block.settings.highlights != blank %}
                <div class="lp-clinician-reviews__highlights rte">{{ block.settings.highlights }}</div>
              {% endif %}

              {% if block.settings.body != blank %}
                <details class="lp-clinician-reviews__evaluation">
                  <summary>Read full evaluation</summary>
                  <div class="lp-clinician-reviews__body rte">{{ block.settings.body }}</div>
                </details>
              {% endif %}

              {% if block.settings.sources_note != blank %}
                <details class="lp-clinician-reviews__sources">
                  <summary>View cited sources</summary>
                  <div class="lp-clinician-reviews__sources-content rte">{{ block.settings.sources_note }}</div>
                </details>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.learn_more_label != blank %}
      <a class="lp-clinician-reviews__learn-more" href="#LpClinicianDisclaimer-{{ section.id }}">{{ section.settings.learn_more_label | escape }}</a>
    {% endif %}

    {% if has_app_block %}
      <div class="lp-clinician-reviews__app">
        {% for block in section.blocks %}
          {% if block.type == '@app' %}
            {% render block %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <footer class="lp-clinician-reviews__footer">
      {% if section.settings.footer_text != blank %}
        <p class="lp-clinician-reviews__powered-by">{{ section.settings.footer_text | escape }}</p>
      {% endif %}
      {% if section.settings.disclaimer != blank %}
        <div id="LpClinicianDisclaimer-{{ section.id }}" class="lp-clinician-reviews__disclaimer rte">{{ section.settings.disclaimer }}</div>
      {% endif %}
    </footer>
  </div>
</section>

{% schema %}
{
  "name": "LP clinician reviews",
  "tag": "section",
  "class": "lp-clinician-reviews__wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clinician Reviews"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Independent Clinician Evaluations"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Clinicians can receive product samples and are <em>never compensated</em> to submit evaluations.</p>"
    },
    {
      "type": "text",
      "id": "learn_more_label",
      "label": "Learn more label",
      "default": "Learn more"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Clinician reviews powered by frontrowMD"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>†This clinician wants to clarify that larger-scale research to support their product claims is still developing. These statements have not been reviewed by the FDA and are not intended to be medical advice.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID"
    }
  ],
  "blocks": [
    {
      "type": "clinician_card",
      "name": "Clinician card",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Clinician photo"
        },
        {
          "type": "text",
          "id": "avatar_url",
          "label": "Clinician photo URL"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Dr. Enza Caputo, MD"
        },
        {
          "type": "text",
          "id": "verified_label",
          "label": "Verified label",
          "default": "Verified clinician"
        },
        {
          "type": "text",
          "id": "specialty",
          "label": "Specialty",
          "default": "Pediatrics"
        },
        {
          "type": "text",
          "id": "years",
          "label": "Years in practice",
          "default": "37"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kids daily multivitamin made with easily absorbable nutrients"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body"
        },
        {
          "type": "richtext",
          "id": "sources_note",
          "label": "Sources note"
        },
        {
          "type": "richtext",
          "id": "highlights",
          "label": "Highlights"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "LP clinician reviews"
    }
  ],
  "enabled_on": {
    "templates": [
      "page",
      "index",
      "product"
    ]
  }
}
{% endschema %}
