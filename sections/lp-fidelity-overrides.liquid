/* ---------------------------------------------------------------------------
   1. Two token errors that produced most of the audit's findings.
   --------------------------------------------------------------------------- */

:root {
  /* The original sets sofia-pro on headings as well as body — the whole page is one sans
     family. We shipped a serif (gelica) on every heading, which is the single biggest reason
     the two pages read differently, and it is what "font weights — was that purposeful?" was
     pointing at. Measured: h1, section h2s and panel titles all resolve to sofia-pro. */
  --lp-font-heading: 'sofia-pro', var(--font-body-family), system-ui, sans-serif;

  /* Measured rgb(44, 61, 80) = #2C3D50. We shipped #2C3E50 — one digit out, which put a
     wrong-by-one text colour on nearly every element of the page. */
  --lp-navy: #2c3d50;
}

/* Most text does not read --lp-navy at all: it reads --color-foreground, which Dawn sets per
   colour scheme from settings_data.json. Correcting the token alone left the wrong colour
   everywhere it actually mattered. Only the two light schemes are touched — scheme-3 is the
   dark band and its foreground is white by design. */
.color-scheme-1,
.color-scheme-2 {
  --color-foreground: 44, 61, 80;
}

/* ---------------------------------------------------------------------------
   2. Headings — the original runs them lighter, tighter and untracked.
   --------------------------------------------------------------------------- */

/* Measured across every heading role: weight 600, letter-spacing normal. We shipped 700 with
   negative tracking at display sizes, which made them read as a different typeface before the
   family is even considered.

   The selector carries the section prefix on purpose. lp-brand.css sets the 700 through
   `.shopify-section[class*="lp-"] h1` — specificity 0,2,1 — so a bare class here loses even
   though this file loads last. Matching the shape beats it at 0,3,0 without reaching for
   !important, which would only move the problem to whoever overrides this next. */
.shopify-section[class*='lp-'] .lp-hero__heading,
.shopify-section[class*='lp-'] .lp-media-accordion__heading,
.shopify-section[class*='lp-'] .lp-science-tabs__heading,
.shopify-section[class*='lp-'] .lp-science-tabs__panel-heading {
  font-weight: 600;
  letter-spacing: normal;
}

/* Hero h1 — measured 28px, 28px line-height, capitalize. Ours ran 42px at desktop. */
.lp-hero__heading {
  font-size: 2.8rem;
  line-height: 2.8rem;
  text-transform: capitalize;
}

/* The two section h2s look like one role and are not. Measured at 1440: the accordion's is
   38px on a 38px line and capitalized; the tabs' is 38px on a 53.2px line with no transform.
   Grouping them cost a line-height and a text-transform in the previous pass.

   The accordion heading is also the one element on the page that keeps #2C3E50 while
   everything around it is #2C3D50 — the scheme-level correction above is right for the page
   and wrong here, so it is put back by hand rather than by weakening the rule that fixed
   forty other elements. */
.lp-media-accordion__heading {
  font-size: 3.8rem;
  line-height: 3.8rem;
  text-transform: capitalize;
  text-align: center;
}

/* Prefixed for the same reason the heading weights are: a bare class loses to the
   colour-scheme rule that sets --color-foreground. */
.shopify-section[class*='lp-'] .lp-media-accordion__heading {
  color: #2c3e50;
}

.lp-science-tabs__heading {
  font-size: 3.8rem;
  line-height: 5.32rem;
  text-transform: none;
  text-align: center;
}

/* Tab panel title — measured 24px / 33.6px, centred. The class is __panel-heading; the
   previous pass guessed __content-title and silently styled nothing. */
.shopify-section[class*='lp-'] .lp-science-tabs__panel-heading {
  font-size: 2.4rem;
  font-weight: 600;
  line-height: 3.36rem;
  letter-spacing: normal;
  text-align: center;
}

/* Tab panel body — measured 18px / 25.2px. */
.lp-science-tabs__panel-content p {
  font-size: 1.8rem;
  line-height: 2.52rem;
}

/* ---------------------------------------------------------------------------
   3. Hero details
   --------------------------------------------------------------------------- */

/* CTA label measured 18px / 600 / 25.2px. */
/* The original ranges the CTA label rather than centring it. */
.lp-hero__cta {
  font-size: 1.8rem;
  font-weight: 600;
  line-height: 2.52rem;
  text-align: start;
}

/* Review line measured 14px / 400 / 19.6px — ours was 13px and bold, which made a quiet
   proof line shout. */
.lp-hero__badge {
  font-size: 1.4rem;
  font-weight: 400;
  line-height: 1.96rem;
}

/* ---------------------------------------------------------------------------
   4. Accordion
   --------------------------------------------------------------------------- */

/* Item title measured 18px / 600 / 18px in #1A1A1A — near-black, not the page navy. */
.lp-media-accordion__title {
  font-size: 1.8rem;
  font-weight: 600;
  line-height: 1.8rem;
  letter-spacing: normal;
  color: #1a1a1a;
}

/* CTA measured 14px/32px padding, 8px radius, no border, and a flat mint ring at zero offset
   and zero blur. Ours was a fully rounded pill with a 1px border and no ring. */
.lp-media-accordion__cta {
  padding: 1.4rem 3.2rem;
  border: 0;
  border-radius: 0.8rem;
  box-shadow: 0 0 0 0 rgb(168, 232, 226);
  font-weight: 600;
  line-height: 1.92rem;
}

/* Guarantee measured 14px / 500 / 18.2px in #333. */
.lp-media-accordion__guarantee,
.lp-media-accordion__guarantee span {
  font-size: 1.4rem;
  font-weight: 500;
  line-height: 1.82rem;
  color: #333;
}

/* ---------------------------------------------------------------------------
   5. Science tabs
   --------------------------------------------------------------------------- */

/* Tab measured: label weight 400 (ours 600), 12px/20px padding, no border, 8px gap,
   1000px radius. */
.lp-science-tabs__tab {
  padding: 1.2rem 2rem;
  border: 0;
  border-radius: 1000px;
  gap: 0.8rem;
  font-weight: 400;
  line-height: 2.24rem;
}

/* ---------------------------------------------------------------------------
   6. Buy box
   --------------------------------------------------------------------------- */

/* This is the image-crop finding. The original fits the whole product image inside its frame
   (contain, natural ratio); ours forced a 1:1 box and cropped to fill, which is why the packs
   sat differently against the frame. */
.lp-buy-box__media-frame img {
  object-fit: contain;
  aspect-ratio: auto;
}

/* Group legends measured 20px / 28px, untracked, at weight 708. sofia-pro ships 400/700/800/
   900, so 708 and 700 both draw with the 700 face — the reference simply declares an odd
   number. Matching the declaration costs nothing and stops it reading as an open gap. */
.lp-buy-box__legend {
  font-size: 2rem;
  line-height: 2.8rem;
  letter-spacing: normal;
  font-weight: 708;
}

/* Same 708 declaration on the other three buy-box roles the reference sets it on. */
.lp-buy-box__delivery-title,
.lp-buy-box__price,
.lp-buy-box__quantity-label {
  font-weight: 708;
}

/* The reference names "Sofia Sans" first here. No @font-face anywhere defines it, so it falls
   straight through to sofia-pro and draws identically — the stack is matched so the comparison
   is clean rather than carrying a difference that has no visual effect. */
.lp-buy-box__quantity-note {
  font-family: 'Sofia Sans', sofia-pro, sofia-pro, -apple-system, sans-serif;
}

/* Plan label measured 22.4px line-height. */
.lp-buy-box__delivery-title {
  line-height: 2.24rem;
}

/* Prices measured ranged left, not right — the original keeps the plan row left-aligned and
   lets the price sit where the text ends. */
.lp-buy-box__price,
.lp-buy-box__price-compare,
.lp-buy-box__price-note,
.lp-buy-box__delivery-prices {
  text-align: start;
}

.lp-buy-box__price {
  line-height: 2.52rem;
}

/* Compare-at and the discount note measured 14px / 19.6px in #737373 — a true grey, not
   tinted navy. */
.lp-buy-box__price-compare,
.lp-buy-box__delivery-prices s,
.lp-buy-box__price-note {
  font-size: 1.4rem;
  line-height: 1.96rem;
  color: #737373;
}

/* Plan benefit lines measured 14px / 19.6px at full opacity. Ours were 12.5px at 75%, which
   is what made the plan card feel denser than the original's. */
.lp-buy-box__delivery-copy,
.lp-buy-box__delivery-copy li {
  font-size: 1.4rem;
  line-height: 1.96rem;
  color: var(--lp-navy);
}

/* "Lowest Price Anywhere!" measured 14px / 400 / centred, 12px side padding, 200px radius,
   no top margin. */
.lp-buy-box__delivery-badge {
  font-size: 1.4rem;
  font-weight: 400;
  line-height: 1.96rem;
  text-align: center;
  margin-top: 0;
  padding-left: 1.2rem;
  padding-right: 1.2rem;
  border-radius: 200px;
}

/* Servings note measured as white 14px/400 on a solid grey #71767E chip with a 4px radius.
   Ours was bold navy on a tinted pill — a different object entirely. */
.lp-buy-box__quantity-note {
  font-size: 1.4rem;
  font-weight: 400;
  line-height: 1.96rem;
  color: #fff;
  background: #71767e;
  margin-bottom: 0;
  padding: 0.4rem 1.2rem;
  border-radius: 0.4rem;
}

/* Quantity tier label measured 16px / 22.4px. */
.lp-buy-box__quantity-label {
  font-size: 1.6rem;
  line-height: 2.24rem;
}

/* Savings chip measured as navy 14px/400 on pale blue #F2FBFF, 4px radius, 12px side padding.
   Ours was white on solid green with a pill — the loudest single difference in the buy box. */
.lp-buy-box__savings {
  font-size: 1.4rem;
  font-weight: 400;
  line-height: 1.96rem;
  color: var(--lp-navy);
  background: #f2fbff;
  padding: 0.4rem 1.2rem;
  border-radius: 0;
}

/* ---------------------------------------------------------------------------
   The override section still emits a section wrapper; keep it out of the flow.
   --------------------------------------------------------------------------- */

.lp-fidelity-overrides {
  display: none;
}

/* ---------------------------------------------------------------------------
   7. Mobile. The reference is not a scaled-down desktop — it resets type at 390px, and
   fixed desktop values above would otherwise ship a phone page that is too large
   everywhere. All measured at 390px.
   --------------------------------------------------------------------------- */

@media screen and (max-width: 749px) {
  .lp-media-accordion__heading {
    font-size: 2.4rem;
    line-height: 2.4rem;
  }

  .lp-science-tabs__heading {
    font-size: 2.4rem;
    line-height: 3.36rem;
  }

  .lp-media-accordion__title {
    font-size: 1.6rem;
    line-height: 1.6rem;
  }

  .lp-media-accordion__cta {
    line-height: 1.8rem;
  }

  .lp-science-tabs__tab {
    font-size: 1.6rem;
    padding-top: 1.8rem;
    padding-bottom: 1.8rem;
    /* The tab keeps a hairline border on mobile and drops it at desktop. */
    border: 1px solid currentColor;
  }

  .shopify-section[class*='lp-'] .lp-science-tabs__panel-heading {
    font-size: 2.2rem;
    line-height: 3.08rem;
  }

  .lp-science-tabs__panel-content p {
    font-size: 1.6rem;
    line-height: 2.24rem;
  }

  .lp-buy-box__quantity-label {
    font-size: 1.4rem;
    line-height: 1.96rem;
  }
}

/* ---------------------------------------------------------------------------
   8. Layout. The first pass of this file corrected type and left the page visibly wrong,
   because a heading can carry the right family, size and weight and still wrap where the
   reference does not — and everything below it then shifts. These are measured boxes:
   reference rect vs ours, at 1440 and 390.
   --------------------------------------------------------------------------- */

/* The reference runs its content at ~1184px inside ~120px gutters at 1440. Ours ran 880,
   which is the single cause of most of the wrapping differences below it. */
.lp-science-tabs__component,
.lp-science-tabs__panels,
.lp-science-tabs__tab-list {
  max-width: 118.4rem;
}

/* Measured x=121 w=1184, ranged left with a 12px gap. Ours centred at 880 with 8px. */
.lp-science-tabs__tab-list {
  justify-content: flex-start;
  gap: 1.2rem;
}

/* The reference panel is a flex row that lets the copy take the space it needs; ours pinned
   the text to a 484px track and the media to 300px, which squeezed both. */
.lp-science-tabs__panel {
  display: flex;
  align-items: stretch;
  gap: 0;
  max-width: 118.4rem;
}

/* Hero h1 measured 560px wide on one 56px line. `max-width: 17ch` resolved to 310px, so it
   wrapped to two lines and pushed every following block down. */
.lp-hero__heading {
  max-width: 56rem;
}

/* Accordion heading measured 1168px — full container width, one line. Ours was capped at the
   text column and ran to three. */
.lp-media-accordion__heading {
  max-width: none;
}

/* The accordion CTA block is a centred 720px column in the reference, not a flex stack. */
.lp-media-accordion__cta-block {
  display: block;
  max-width: 72rem;
  margin-inline: auto;
}

/* Quantity tiers are a 2x2 grid in the reference at desktop — 334px per column with a 12px
   gutter. Ours switched to four across at the same breakpoint, which is why the tier cards
   read as a strip rather than a block. */
.lp-buy-box__quantity-grid {
  gap: 1.2rem;
}

@media screen and (min-width: 750px) {
  .lp-buy-box__quantity-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* Delivery options stack in the reference rather than sharing a grid gutter. */
.lp-buy-box__delivery {
  row-gap: 1.2rem;
}

@media screen and (max-width: 749px) {
  /* At 390 the reference gives the hero copy the full 343px content width. */
  .lp-hero__heading {
    max-width: none;
  }

  /* Panel is a column on mobile; ours stayed a row and squeezed the media. */
  .lp-science-tabs__panel {
    flex-direction: column;
  }

  .lp-science-tabs__tab-list {
    max-width: none;
  }
}

{% endstyle %}

