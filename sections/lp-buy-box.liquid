{{ 'lp-buy-box.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lp-buy-box.js' | asset_url }}" defer="defer"></script>

{% liquid
  # When this section is re-rendered through the Section Rendering API as
  # /products/<handle>?section_id=<id>, Liquid's `product` is that product — that is what
  # powers switching age groups without a page load. On the LP itself `product` is nil and
  # the section setting applies.
  assign buy_product = product | default: section.settings.product

  # Product facts live on the PRODUCT (metafields), not on the page: the same product sells
  # across ~18 behind-the-science LPs, so one edit propagates instead of 18. A section setting
  # still wins when a specific variant page must say something different.
  assign mf = buy_product.metafields.custom
  assign fact_subtitle = section.settings.subtitle | default: mf.subtitle.value
  assign fact_description = section.settings.description | default: mf.short_description.value
  assign fact_flavor = section.settings.flavor_text | default: mf.flavor.value
  assign fact_qty_note = section.settings.qty_note | default: mf.servings_per_bottle.value
  assign fact_ages_note = section.settings.ages_note | default: mf.age_range.value

  # Real Shopify selling plans, when the product has them. The subscription card stops being a
  # picture of an offer and becomes the offer: its price comes from the plan's own pricing
  # policy and the form posts selling_plan, so checkout receives a subscription line.
  assign plan_group = buy_product.selling_plan_groups | first
  assign selling_plan = nil
  if plan_group != blank
    assign selling_plan = plan_group.selling_plans | first
  endif
  assign plan_variant = nil
  if selling_plan != blank and current_variant != blank
    for allocation in current_variant.selling_plan_allocations
      if allocation.selling_plan.id == selling_plan.id
        assign plan_variant = allocation
        break
      endif
    endfor
  endif
  assign product_benefits = mf.benefits.value
  assign current_variant = buy_product.selected_or_first_available_variant
  assign product_form_id = 'LpBuyBoxForm-' | append: section.id
  assign fallback_media_count = 0
  assign initial_quantity = 1
  assign selected_quantity_found = false

  for block in section.blocks
    if block.type == 'carousel_image'
      assign fallback_media_count = fallback_media_count | plus: 1
    endif
  endfor

  assign quantity_index = 0
  assign selected_quantity_found = false
  for block in section.blocks
    if block.type == 'qty_tier'
      assign quantity_index = quantity_index | plus: 1
      if block.settings.selected and selected_quantity_found == false
        assign initial_quantity = quantity_index
        assign selected_quantity_found = true
      endif
    endif
  endfor
%}

{% comment %}
  Subscription selection, gift progress, and upsell controls are static UI stubs (app
  territory — see ASSUMPTIONS). The product form always adds the selected variant one-time.
{% endcomment %}
<lp-buy-box
  id="{{ section.settings.anchor_id | default: section.id }}"
  data-section-id="{{ section.id }}"
  data-current-handle="{{ buy_product.handle }}"
  class="lp-buy-box__section color-{{ section.settings.color_scheme }} gradient"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="lp-buy-box__page-width">
    <div class="lp-buy-box__layout">
      <div class="lp-buy-box__media-column">
        <div class="lp-buy-box__media-frame">
          <button class="lp-buy-box__media-nav lp-buy-box__media-nav--prev" type="button" data-media-prev aria-label="Previous image">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="lp-buy-box__media-nav lp-buy-box__media-nav--next" type="button" data-media-next aria-label="Next image">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="lp-buy-box__media-track" data-media-track>
          {% if buy_product.media.size > 0 %}
            {% for media in buy_product.media %}
              {% assign gallery_alt = buy_product.title | append: ' — product image ' | append: forloop.index | append: ' of ' | append: buy_product.media.size %}
              <div
                class="lp-buy-box__media-slide"
                data-media-slide
                data-media-index="{{ forloop.index0 }}"
                id="LpBuyBoxMedia-{{ section.id }}-{{ forloop.index0 }}"
              >
                {% if media.media_type == 'image' %}
                  {{
                    media
                    | image_url: width: 1400
                    | image_tag:
                      widths: '360, 540, 720, 960, 1200, 1400',
                      sizes: '(min-width: 990px) 50vw, 100vw',
                      class: 'lp-buy-box__media-image',
                      loading: 'lazy',
                      alt: gallery_alt
                  }}
                {% else %}
                  {{ media | media_tag: image_size: '1400x', controls: true, preload: 'metadata', class: 'lp-buy-box__media-model' }}
                {% endif %}
              </div>
            {% endfor %}
          {% else %}
            {% assign media_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'carousel_image' %}
                <div
                  class="lp-buy-box__media-slide"
                  data-media-slide
                  data-media-index="{{ media_index }}"
                  id="LpBuyBoxMedia-{{ section.id }}-{{ media_index }}"
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 1400
                      | image_tag:
                        widths: '360, 540, 720, 960, 1200, 1400',
                        sizes: '(min-width: 990px) 50vw, 100vw',
                        class: 'lp-buy-box__media-image',
                        loading: 'lazy',
                        alt: block.settings.image.alt
                    }}
                  {% endif %}
                </div>
                {% assign media_index = media_index | plus: 1 %}
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
        </div>

        {% if buy_product.media.size > 1 or fallback_media_count > 1 %}
          <div class="lp-buy-box__thumbnails" data-media-thumbnails>
            {% if buy_product.media.size > 0 %}
              {% for media in buy_product.media %}
                {% assign thumbnail_alt = buy_product.title | append: ' — view product image ' | append: forloop.index | append: ' of ' | append: buy_product.media.size %}
                <button
                  class="lp-buy-box__thumbnail"
                  type="button"
                  data-media-thumb
                  data-media-index="{{ forloop.index0 }}"
                  aria-controls="LpBuyBoxMedia-{{ section.id }}-{{ forloop.index0 }}"
                  aria-label="{{ thumbnail_alt | escape }}"
                  {% if forloop.first %}aria-current="true"{% else %}aria-current="false"{% endif %}
                >
                  {{
                    media.preview_image
                    | image_url: width: 180
                    | image_tag:
                      widths: '90, 180',
                      sizes: '72px',
                      class: 'lp-buy-box__thumbnail-image',
                      loading: 'lazy',
                      alt: thumbnail_alt
                  }}
                </button>
              {% endfor %}
            {% else %}
              {% assign media_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'carousel_image' %}
                  <button
                    class="lp-buy-box__thumbnail"
                    type="button"
                    data-media-thumb
                    data-media-index="{{ media_index }}"
                    aria-controls="LpBuyBoxMedia-{{ section.id }}-{{ media_index }}"
                    aria-label="{{ block.settings.image.alt | escape }}"
                    {% if media_index == 0 %}aria-current="true"{% else %}aria-current="false"{% endif %}
                  >
                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 180
                        | image_tag:
                          widths: '90, 180',
                          sizes: '72px',
                          class: 'lp-buy-box__thumbnail-image',
                          loading: 'lazy',
                          alt: block.settings.image.alt
                      }}
                    {% endif %}
                  </button>
                  {% assign media_index = media_index | plus: 1 %}
                {% endif %}
              {% endfor %}
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="lp-buy-box__buy-column">
        {% assign product_tab_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'product_tab' %}
            {% assign product_tab_count = product_tab_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if product_tab_count > 0 %}
          <nav class="lp-buy-box__product-tabs" aria-label="{{ buy_product.title | escape }}">
            {% for block in section.blocks %}
              {% if block.type == 'product_tab' %}
                {% assign product_tab_url = block.settings.url | default: block.settings.product.url %}
                {% if product_tab_url != blank %}
                  <a
                    class="lp-buy-box__product-tab"
                    href="{{ product_tab_url }}"
                    {% if block.settings.product != blank %}data-product-handle="{{ block.settings.product.handle }}"{% endif %}
                    {% if block.settings.active %}aria-current="page"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.label | escape -}}
                  </a>
                {% else %}
                  <span
                    class="lp-buy-box__product-tab"
                    {% if block.settings.product != blank %}data-product-handle="{{ block.settings.product.handle }}"{% endif %}
                    {% if block.settings.active %}aria-current="page"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.label | escape -}}
                  </span>
                {% endif %}
              {% endif %}
            {% endfor %}
          </nav>
        {% endif %}

        <div class="lp-buy-box__heading-group">
          {% assign formatted_product_title = buy_product.title | escape | replace: '™', '<sup class="lp-buy-box__tm">™</sup>' %}
          <h2 class="lp-buy-box__title">{{ formatted_product_title }}</h2>
          {% if fact_subtitle != blank %}
            <p class="lp-buy-box__subtitle">
              {%- if section.settings.subtitle != blank -%}
                {{- section.settings.subtitle -}}
              {%- else -%}
                {{- fact_subtitle | escape -}}
              {%- endif -%}
            </p>
          {% endif %}
        </div>

        <div class="lp-buy-box__rating">
          <svg class="lp-buy-box__rating-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m12 2.4 2.8 5.7 6.3.9-4.5 4.4 1.1 6.2-5.7-3-5.7 3 1.1-6.2L2.9 9l6.3-.9L12 2.4Z" fill="currentColor"/>
          </svg>
          <span class="lp-buy-box__rating-value">{{ section.settings.rating_stars | escape }}</span>
          <span class="lp-buy-box__rating-text">{{ section.settings.rating_text | escape }}</span>
        </div>

        {% if fact_description != blank %}
          <p class="lp-buy-box__description">{{ fact_description | escape }}</p>
        {% endif %}
        {% if fact_flavor != blank %}
          <p class="lp-buy-box__flavor">{{ fact_flavor | escape }}</p>
        {% endif %}

        <div class="lp-buy-box__benefits">
          {% if product_benefits != blank %}
            {% for benefit in product_benefits %}
              {% liquid
                assign benefit_icon = benefit.icon
                if benefit_icon == blank
                  case benefit.title
                    when 'Improve Overall Health & Nutrition'
                      assign benefit_icon = 'health'
                    when 'Boost Mood & Motivation'
                      assign benefit_icon = 'mood'
                    when 'Promote Clear Skin'
                      assign benefit_icon = 'skin'
                    when 'Enhanced Nutrition & Immunity'
                      assign benefit_icon = 'immunity'
                    when 'Improved Behavior'
                      assign benefit_icon = 'behavior'
                    when 'Better Sleep Routines'
                      assign benefit_icon = 'sleep'
                  endcase
                endif
              %}
              <details class="lp-buy-box__benefit">
                <summary class="lp-buy-box__benefit-summary">
                  <span class="lp-buy-box__benefit-heading">
                    <span class="lp-buy-box__benefit-icon lp-buy-box__benefit-icon--symbol" data-benefit-icon="{{ benefit_icon | escape }}" aria-hidden="true">
                      {% case benefit_icon %}
                        {% when 'health' %}
                          <svg viewBox="0 0 24 24" focusable="false"><path d="M20.4 5.8a5.1 5.1 0 0 0-7.2 0L12 7l-1.2-1.2a5.1 5.1 0 0 0-7.2 7.2L12 21l8.4-8a5.1 5.1 0 0 0 0-7.2Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.6"/><path d="M5.5 12h3l1.4-2.7 2.4 5.5 1.6-2.8h4.6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/></svg>
                        {% when 'mood' %}
                          <svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="6.3" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M9.3 13.1c.7 1.4 1.6 2 2.7 2s2-.6 2.7-2M9.4 10h.1m5 0h.1M12 2.2v2M12 19.8v2M2.2 12h2M19.8 12h2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6"/></svg>
                        {% when 'skin' %}
                          <svg viewBox="0 0 24 24" focusable="false"><path d="M12 3.1c-3 3.6-5 6.4-5 9.2a5 5 0 0 0 10 0c0-2.8-2-5.6-5-9.2Z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M17.7 3.2v3.6M15.9 5h3.6M19.2 9.2v2.6M17.9 10.5h2.6M9.6 14.8c.6.8 1.4 1.2 2.4 1.2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6"/></svg>
                        {% when 'behavior' %}
                          <svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="8.8" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8.4 10h.1m7 0h.1M8.4 14c1 1.5 2.2 2.2 3.6 2.2s2.6-.7 3.6-2.2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"/></svg>
                        {% when 'sleep' %}
                          <svg viewBox="0 0 24 24" focusable="false"><path d="M18.2 15.8A7.4 7.4 0 0 1 8.2 5.7a7.8 7.8 0 1 0 10 10.1Z" fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.6"/><path d="m16.9 4 .5 1.1 1.2.2-.9.8.2 1.2-1-.6-1 .6.2-1.2-.9-.8 1.2-.2.5-1.1Z" fill="currentColor"/></svg>
                        {% else %}
                          <svg viewBox="0 0 24 24" focusable="false"><path d="M12 2.8 4.8 5.5v5.8c0 4.1 2.4 7.3 7.2 9.9 4.8-2.6 7.2-5.8 7.2-9.9V5.5L12 2.8Z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 8v7M8.5 11.5h7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6"/></svg>
                      {% endcase %}
                    </span>
                    <span>{{ benefit.title | escape }}</span>
                  </span>
                  <svg class="lp-buy-box__benefit-chevron" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                  </svg>
                </summary>
                <div class="lp-buy-box__benefit-content">
                  <strong class="lp-buy-box__benefit-stat">{{ benefit.stat | escape }}</strong>
                  <p class="lp-buy-box__benefit-text">{{ benefit.text | escape }}</p>
                </div>
              </details>
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}
              {% if block.type == 'benefit' %}
                <details class="lp-buy-box__benefit" {{ block.shopify_attributes }}>
                  <summary class="lp-buy-box__benefit-summary">
                    <span class="lp-buy-box__benefit-heading">
                      {% if block.settings.image != blank %}
                        {{
                          block.settings.image
                          | image_url: width: 128
                          | image_tag:
                            widths: '64, 128',
                            sizes: '48px',
                            class: 'lp-buy-box__benefit-icon',
                            loading: 'lazy',
                            alt: block.settings.image.alt
                        }}
                      {% endif %}
                      <span>{{ block.settings.title | escape }}</span>
                    </span>
                    <svg class="lp-buy-box__benefit-chevron" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                      <path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                    </svg>
                  </summary>
                  <div class="lp-buy-box__benefit-content">
                    <strong class="lp-buy-box__benefit-stat">{{ block.settings.stat | escape }}</strong>
                    <p class="lp-buy-box__benefit-text">{{ block.settings.text | escape }}</p>
                  </div>
                </details>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>

        {% form 'product', buy_product, id: product_form_id, class: 'lp-buy-box__form' %}
          <input
            type="hidden"
            name="id"
            value="{{ current_variant.id }}"
            {% if current_variant == blank %}disabled{% endif %}
          >
          <input type="hidden" name="quantity" value="{{ initial_quantity }}" data-quantity-input>
          {%- if selling_plan != blank -%}
            <input type="hidden" name="selling_plan" value="{{ selling_plan.id }}" data-selling-plan-input>
          {%- endif -%}

          <fieldset class="lp-buy-box__fieldset lp-buy-box__delivery">
            <legend class="lp-buy-box__legend">{{ section.settings.frequency_heading | escape }}</legend>

            <div class="lp-buy-box__delivery-option">
              <input
                class="lp-buy-box__choice-input"
                type="radio"
                name="lp-delivery-{{ section.id }}"
                id="LpDeliveryMonthly-{{ section.id }}"
                value="monthly"
                checked
                data-delivery-radio
              >
              <label class="lp-buy-box__delivery-card" for="LpDeliveryMonthly-{{ section.id }}">
                <span class="lp-buy-box__delivery-top">
                  <span class="lp-buy-box__radio-mark" aria-hidden="true"></span>
                  <strong class="lp-buy-box__delivery-title">{{ selling_plan.name | default: section.settings.sub_title | escape }}</strong>
                  <span class="lp-buy-box__delivery-prices">
                    {%- if plan_variant != blank -%}
                      <s class="lp-buy-box__compare-price">{{ plan_variant.compare_at_price | default: current_variant.price | money }}</s>
                      <strong class="lp-buy-box__price lp-buy-box__price--subscription">{{ plan_variant.price | money }}</strong>
                    {%- else -%}
                      <s class="lp-buy-box__compare-price">{{ section.settings.sub_compare | escape }}</s>
                      <strong class="lp-buy-box__price lp-buy-box__price--subscription">{{ section.settings.sub_price | escape }}</strong>
                    {%- endif -%}
                  </span>
                </span>
                {% if section.settings.sub_perks != blank %}
                  <div class="lp-buy-box__delivery-copy">{{ section.settings.sub_perks }}</div>
                {% endif %}
                {% if section.settings.sub_badge != blank %}
                  <span class="lp-buy-box__delivery-badge">{{ section.settings.sub_badge | escape }}</span>
                {% endif %}
              </label>
            </div>

            <div class="lp-buy-box__delivery-option">
              <input
                class="lp-buy-box__choice-input"
                type="radio"
                name="lp-delivery-{{ section.id }}"
                id="LpDeliveryOneTime-{{ section.id }}"
                value="one-time"
                data-delivery-radio
              >
              <label class="lp-buy-box__delivery-card" for="LpDeliveryOneTime-{{ section.id }}">
                <span class="lp-buy-box__delivery-top">
                  <span class="lp-buy-box__radio-mark" aria-hidden="true"></span>
                  <strong class="lp-buy-box__delivery-title">{{ section.settings.ot_title | escape }}</strong>
                  <span class="lp-buy-box__delivery-prices">
                    {%- if current_variant != blank -%}
                      {%- if current_variant.compare_at_price > current_variant.price -%}
                        <s class="lp-buy-box__compare-price">{{ current_variant.compare_at_price | money }}</s>
                      {%- endif -%}
                      <strong class="lp-buy-box__price">{{ current_variant.price | money }}</strong>
                    {%- else -%}
                      <s class="lp-buy-box__compare-price">{{ section.settings.ot_compare | escape }}</s>
                      <strong class="lp-buy-box__price">{{ section.settings.ot_price | escape }}</strong>
                    {%- endif -%}
                    {% if section.settings.ot_note != blank %}
                      <small class="lp-buy-box__price-note">{{ section.settings.ot_note | escape }}</small>
                    {% endif %}
                  </span>
                </span>
                {% if section.settings.ot_warning != blank %}
                  <div class="lp-buy-box__delivery-copy lp-buy-box__delivery-copy--warning">
                    {{- section.settings.ot_warning -}}
                  </div>
                {% endif %}
              </label>
            </div>
          </fieldset>

          <fieldset class="lp-buy-box__fieldset lp-buy-box__quantity">
            <legend class="lp-buy-box__legend">{{ section.settings.quantity_heading | escape }}</legend>
            <span class="lp-buy-box__quantity-note">{{ fact_qty_note | escape }}</span>
            <div class="lp-buy-box__quantity-grid">
              {% assign quantity_index = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'qty_tier' %}
                  {% assign quantity_index = quantity_index | plus: 1 %}
                  <div class="lp-buy-box__quantity-option" {{ block.shopify_attributes }}>
                    <input
                      class="lp-buy-box__choice-input"
                      type="radio"
                      name="lp-quantity-{{ section.id }}"
                      id="LpQuantity-{{ section.id }}-{{ quantity_index }}"
                      value="{{ quantity_index }}"
                      data-quantity-radio
                      data-quantity-value="{{ quantity_index }}"
                      {% if quantity_index == initial_quantity %}checked{% endif %}
                    >
                    <label class="lp-buy-box__quantity-card" for="LpQuantity-{{ section.id }}-{{ quantity_index }}">
                      <strong class="lp-buy-box__quantity-label">{{ block.settings.label | escape }}</strong>
                      {% if block.settings.savings != blank %}
                        <span
                          class="lp-buy-box__savings"
                          data-quantity-savings
                          data-subscription-savings="{{ block.settings.savings | escape }}"
                        >{{ block.settings.savings | escape }}</span>
                      {% endif %}
                    </label>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </fieldset>

          {%- comment -%}
            Empty heading switches the whole gift bar off — no empty frame, no dead progress
            bar. The behaviour below stays wired, so turning it back on is a setting, not a
            deploy.
          {%- endcomment -%}
          {% if section.settings.gift_heading != blank %}
          <div class="lp-buy-box__gift">
            <div class="lp-buy-box__gift-content">
              <div class="lp-buy-box__gift-copy">
                <h3 class="lp-buy-box__gift-heading">{{ section.settings.gift_heading | escape }}</h3>
                <p class="lp-buy-box__gift-subtitle">{{ section.settings.gift_sub | escape }}</p>
              </div>
              <div class="lp-buy-box__gift-product">
                {% if section.settings.gift_image != blank %}
                  {{
                    section.settings.gift_image
                    | image_url: width: 440
                    | image_tag:
                      widths: '220, 440',
                      sizes: '110px',
                      class: 'lp-buy-box__gift-image',
                      loading: 'lazy',
                      alt: section.settings.gift_image.alt
                  }}
                {% endif %}
                <span class="lp-buy-box__gift-price">
                  <s>{{ section.settings.gift_compare | escape }}</s>
                  <strong>{{ section.settings.gift_price | escape }}</strong>
                </span>
              </div>
            </div>
            {%- comment -%}
              Live against the real cart: the copy and the bar are rendered from the setting so
              the page is correct with JS off, then updated from /cart.js on load and after any
              add-to-cart. A progress bar that shows a number it does not know is worse than no
              bar at all.
            {%- endcomment -%}
            <p class="lp-buy-box__gift-progress-text" data-gift-text>{{ section.settings.gift_progress_text | escape }}</p>
            <div
              class="lp-buy-box__progress"
              role="progressbar"
              aria-label="{{ section.settings.gift_progress_text | escape }}"
              aria-valuemin="0"
              aria-valuemax="{{ section.settings.gift_threshold_amount }}"
              aria-valuenow="0"
              data-gift-progress
              data-gift-threshold="{{ section.settings.gift_threshold_amount }}"
              data-gift-away-template="{{ section.settings.gift_away_template | escape }}"
              data-gift-unlocked-text="{{ section.settings.gift_unlocked_text | escape }}"
            >
              <span class="lp-buy-box__progress-fill"></span>
              <span class="lp-buy-box__progress-threshold">{{ section.settings.gift_threshold | escape }}</span>
            </div>
          </div>
          {% endif %}

          {%- assign upsell_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'upsell' -%}
              {%- assign upsell_count = upsell_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {% if upsell_count > 0 %}
          <div class="lp-buy-box__upsells">
            {% for block in section.blocks %}
              {% if block.type == 'upsell' %}
                <article class="lp-buy-box__upsell" {{ block.shopify_attributes }}>
                  <div class="lp-buy-box__upsell-product">
                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 128
                        | image_tag:
                          widths: '64, 128',
                          sizes: '64px',
                          class: 'lp-buy-box__upsell-image',
                          loading: 'lazy',
                          alt: block.settings.image.alt
                      }}
                    {% endif %}
                    <div class="lp-buy-box__upsell-copy">
                      <h3 class="lp-buy-box__upsell-title">{{ block.settings.title | escape }}</h3>
                      <p class="lp-buy-box__upsell-subtitle">{{ block.settings.subtitle | escape }}</p>
                    </div>
                  </div>
                  {%- liquid
                    assign up_product = block.settings.product
                    assign up_variant = up_product.selected_or_first_available_variant
                  -%}
                  <div class="lp-buy-box__upsell-controls">
                    <span class="lp-buy-box__upsell-prices">
                      {%- if up_variant != blank -%}
                        {%- if up_variant.compare_at_price > up_variant.price -%}
                          <s>{{ up_variant.compare_at_price | money }}</s>
                        {%- endif -%}
                        <strong>{{ up_variant.price | money }}</strong>
                      {%- else -%}
                        <s>{{ block.settings.compare_price | escape }}</s>
                        <strong>{{ block.settings.price | escape }}</strong>
                      {%- endif -%}
                    </span>
                    <button
                      class="lp-buy-box__upsell-button"
                      type="button"
                      {% if up_variant != blank %}
                        data-upsell-add
                        data-variant-id="{{ up_variant.id }}"
                        aria-label="Add {{ up_product.title | escape }} to cart"
                      {% else %}
                        aria-label="{{ block.settings.title | escape }}"
                        aria-disabled="true"
                      {% endif %}
                    >
                      <svg class="lp-buy-box__upsell-plus" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                        <path d="M10 4v12M4 10h12" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"/>
                      </svg>
                      <svg class="lp-buy-box__upsell-check" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                        <path d="m4 10.5 4 4 8-9" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                      </svg>
                    </button>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
          {% endif %}

          <div class="lp-buy-box__checkout">
            {% if section.settings.urgency_headline != blank %}
              <div class="lp-buy-box__urgency">
                <span class="lp-buy-box__urgency-eyebrow">{{ section.settings.urgency_eyebrow | escape }}</span>
                <strong class="lp-buy-box__urgency-headline">{{ section.settings.urgency_headline | escape }}</strong>
                <span class="lp-buy-box__urgency-offer">{{ section.settings.urgency_offer | escape }}</span>
              </div>
            {% endif %}
            <button
              class="lp-buy-box__submit"
              type="submit"
              name="add"
              data-lp-cta
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <svg class="lp-buy-box__submit-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M3 4h2l2.1 10.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L20 8H7M9.5 20a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0ZM18 20a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
              </svg>
              <span>{{ section.settings.cta_label | escape }}</span>
            </button>
            <p class="lp-buy-box__guarantee">{{ section.settings.guarantee_text | escape }}</p>
          </div>
        {% endform %}

        <div class="lp-buy-box__stamps">
          {% for block in section.blocks %}
            {% if block.type == 'stamp' %}
              <div class="lp-buy-box__stamp{% if block.settings.image != blank %} lp-buy-box__stamp--image{% endif %}" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 192
                    | image_tag:
                      widths: '96, 192',
                      sizes: '96px',
                      class: 'lp-buy-box__stamp-image',
                      alt: block.settings.image.alt,
                      loading: 'lazy'
                  }}
                {% else %}
                  <span>{{ block.settings.line_1 | escape }}</span>
                  <strong>{{ block.settings.line_2 | escape }}</strong>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="lp-buy-box__info-items">
          {% for block in section.blocks %}
            {% if block.type == 'info_item' %}
              <details class="lp-buy-box__info-item" {{ block.shopify_attributes }}>
                <summary class="lp-buy-box__info-summary">
                  <span class="lp-buy-box__info-heading">
                    {% if block.settings.icon != blank %}
                      {{
                        block.settings.icon
                        | image_url: width: 40
                        | image_tag:
                          widths: '20, 40',
                          sizes: '20px',
                          class: 'lp-buy-box__info-icon',
                          loading: 'lazy',
                          alt: ''
                      }}
                    {% endif %}
                    <span>{{ block.settings.title | escape }}</span>
                  </span>
                  <svg class="lp-buy-box__info-chevron" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                    <path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                  </svg>
                </summary>
                <div class="lp-buy-box__info-content">
                  {% if block.settings.body != blank %}
                    <div class="lp-buy-box__info-richtext">{{ block.settings.body }}</div>
                  {% endif %}
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag:
                        widths: '400, 700, 900, 1200',
                        sizes: '(min-width: 990px) 40vw, 90vw',
                        class: 'lp-buy-box__info-image',
                        loading: 'lazy',
                        alt: block.settings.image.alt
                    }}
                  {% endif %}
                </div>
              </details>
            {% endif %}
          {% endfor %}
        </div>

        <div class="lp-buy-box__ages">
          {% if fact_ages_note != blank %}
            <p class="lp-buy-box__ages-note">{{ fact_ages_note | escape }}</p>
          {% endif %}
          <div class="lp-buy-box__age-grid">
            {% for block in section.blocks %}
              {% if block.type == 'age_card' %}
                <a class="lp-buy-box__age-card" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
                  <span class="lp-buy-box__age-copy">
                    <strong>{{ block.settings.label | escape }}</strong>
                    <small>{{ block.settings.sub | escape }}</small>
                  </span>
                  <span class="lp-buy-box__age-arrow" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M2 8h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</lp-buy-box>

{% schema %}
{
