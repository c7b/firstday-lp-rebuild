{{ 'lp-media-accordion.css' | asset_url | stylesheet_tag }}

<section
  id="{{ section.settings.anchor_id | default: section.id }}"
  class="lp-media-accordion__section color-{{ section.settings.color_scheme }} gradient"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="lp-media-accordion__inner{% unless section.settings.show_media %} lp-media-accordion__inner--no-media{% endunless %}{% if section.settings.media_position == 'right' %} lp-media-accordion__inner--media-right{% endif %}">
    <div class="lp-media-accordion__content">
      {% if section.settings.heading != blank %}
        <h2 class="lp-media-accordion__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      <div class="lp-media-accordion__items">
        {% for block in section.blocks %}
          <details
            class="lp-media-accordion__item"
            {% if section.settings.first_open and forloop.first %}open{% endif %}
            {% if section.settings.exclusive %}name="lp-media-accordion-{{ section.id }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="lp-media-accordion__summary">
              <span class="lp-media-accordion__item-header">
                {% if block.settings.icon != blank %}
                  <span class="lp-media-accordion__icon-chip">
                    {{ block.settings.icon | image_url: width: 144 | image_tag: class: 'lp-media-accordion__icon', widths: '40, 56, 72, 144', sizes: '40px', loading: 'lazy', alt: block.settings.icon.alt }}
                  </span>
                {% endif %}
                <span class="lp-media-accordion__title">{{ block.settings.title | escape }}</span>
              </span>
              <span class="lp-media-accordion__chevron" aria-hidden="true"></span>
            </summary>
            <div class="lp-media-accordion__body-wrap">
              <div class="lp-media-accordion__body rte">{{ block.settings.body }}</div>
            </div>
          </details>
        {% endfor %}
      </div>

      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <div class="lp-media-accordion__cta-block">
          <a class="lp-media-accordion__cta" href="{{ section.settings.cta_link }}" data-lp-cta>{{ section.settings.cta_label | escape }}</a>
          {% if section.settings.guarantee_text != blank %}
            {%- comment -%} Card outline in First Day's green, traced from the original. {%- endcomment -%}
            <p class="lp-media-accordion__guarantee">
              <svg class="lp-media-accordion__guarantee-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false">
                <path d="M24.3204 7.78518V20.2149C24.3204 20.7161 24.1474 21.1398 23.8013 21.4859C23.4552 21.832 23.0316 22.0051 22.5305 22.0051H5.46916C4.96807 22.0051 4.54448 21.832 4.19837 21.4859C3.85225 21.1398 3.6792 20.7161 3.6792 20.2149V7.78518C3.6792 7.28391 3.85225 6.86021 4.19837 6.5141C4.54448 6.16799 4.96807 5.99493 5.46916 5.99493H22.5305C23.0316 5.99493 23.4552 6.16799 23.8013 6.5141C24.1474 6.86021 24.3204 7.28391 24.3204 7.78518ZM4.75632 10.3653H23.2433V7.78985C23.2433 7.61038 23.1686 7.44578 23.019 7.29606C22.8695 7.14653 22.705 7.07177 22.5255 7.07177H5.47412C5.29464 7.07177 5.13014 7.14653 4.98062 7.29606C4.83109 7.44578 4.75632 7.61038 4.75632 7.78985V10.3653ZM4.75632 13.004V20.2102C4.75632 20.3897 4.83109 20.5543 4.98062 20.704C5.13014 20.8535 5.29464 20.9283 5.47412 20.9283H22.5255C22.705 20.9283 22.8695 20.8535 23.019 20.704C23.1686 20.5543 23.2433 20.3897 23.2433 20.2102V13.004H4.75632Z" fill="#078942"/>
              </svg>
              <span>{{ section.settings.guarantee_text | escape }}</span>
            </p>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if section.settings.show_media %}
      <div class="lp-media-accordion__media">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1500 | image_tag: class: 'lp-media-accordion__image', widths: '360, 535, 750, 1100, 1500', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image.alt }}
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "LP media accordion",
  "tag": "section",
  "class": "lp-media-accordion__wrapper",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Most Kids Are <span>Missing Key Nutrients</span>. Get Help in Just 2 Gummies."
    },
    {
      "type": "checkbox",
      "id": "show_media",
      "label": "Show media",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ section.settings.show_media }}"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position on desktop",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "visible_if": "{{ section.settings.show_media }}"
    },
    {
      "type": "checkbox",
      "id": "first_open",
      "label": "Open first item",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "exclusive",
      "label": "Only allow one open item",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop Now"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "CTA link (URL or #anchor)",
      "default": "#standalone-product-section"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "45-Day Money Back Guarantee"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets other sections link here, e.g. a CTA pointing at #standalone-product-section. Leave empty unless something links to this section."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Accordion item",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP media accordion"
    }
  ],
  "enabled_on": {
    "templates": [
      "page",
      "index",
      "product"
    ]
  }
}
{% endschema %}
