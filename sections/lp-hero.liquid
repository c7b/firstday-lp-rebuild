{{ 'lp-hero.css' | asset_url | stylesheet_tag }}

{% liquid
  assign media_loading = 'lazy'
  if section.settings.style == 'product'
    assign media_loading = 'eager'
  endif
%}

<section
  id="{{ section.settings.anchor_id | default: section.id }}"
  class="lp-hero__section lp-hero__section--{{ section.settings.style }} lp-hero__section--image-{{ section.settings.image_position }} color-{{ section.settings.color_scheme }} gradient"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="lp-hero__container">
    <div class="lp-hero__content">
      {% if section.settings.style == 'product' %}
        {% if section.settings.badge_text != blank %}
          <div class="lp-hero__badge" aria-label="{{ section.settings.badge_text | escape }}">
            <span class="lp-hero__stars" aria-hidden="true">
              {% for star in (1..5) %}
                <svg viewBox="0 0 20 20" focusable="false"><path d="m10 1.5 2.6 5.3 5.9.9-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.2 5.9-.9Z" /></svg>
              {% endfor %}
            </span>
            <span>{{ section.settings.badge_text | escape }}</span>
          </div>
        {% endif %}
        <h1 class="lp-hero__heading">{{ section.settings.heading }}</h1>
        {% if section.settings.subheading != blank %}
          <div class="lp-hero__subheading rte">{{ section.settings.subheading }}</div>
        {% endif %}
      {% else %}
        <h2 class="lp-hero__heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <div class="lp-hero__subheading rte">{{ section.settings.subheading }}</div>
        {% endif %}
        {% if section.blocks.size > 0 %}
          <div class="lp-hero__stats">
            {% for block in section.blocks %}
              {% if block.type == 'stat_card' %}
                <article class="lp-hero__stat-card" {{ block.shopify_attributes }}>
                  {% if block.settings.line_1 != blank %}<p>{{ block.settings.line_1 | escape }}</p>{% endif %}
                  {% if block.settings.value != blank %}<strong>{{ block.settings.value | escape }}</strong>{% endif %}
                  {% if block.settings.line_2 != blank %}<p>{{ block.settings.line_2 | escape }}</p>{% endif %}
                  {% if block.settings.line_3 != blank %}<p>{{ block.settings.line_3 | escape }}</p>{% endif %}
                </article>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
        {% if section.settings.closing_text != blank %}
          <div class="lp-hero__closing rte">{{ section.settings.closing_text }}</div>
        {% endif %}
        {% if section.settings.closing_text_2 != blank %}
          <div class="lp-hero__closing rte">{{ section.settings.closing_text_2 }}</div>
        {% endif %}
      {% endif %}

      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <a class="lp-hero__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
      {% endif %}
      {% if section.settings.style == 'product' and section.settings.guarantee_text != blank %}
        <p class="lp-hero__guarantee">{{ section.settings.guarantee_text | escape }}</p>
      {% endif %}
    </div>

    <div class="lp-hero__media">
      <picture>
        {% if section.settings.image_mobile != blank %}
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}">
        {% elsif section.settings.image_mobile_url != blank %}
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile_url }}">
        {% endif %}
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'lp-hero__image', widths: '375, 550, 750, 1000, 1600', sizes: '(min-width: 750px) 50vw, 100vw', loading: media_loading, alt: section.settings.image_alt }}
        {% elsif section.settings.image_url != blank %}
          <img class="lp-hero__image" src="{{ section.settings.image_url }}" alt="{{ section.settings.image_alt | escape }}" loading="{{ media_loading }}">
        {% endif %}
      </picture>

      {% if section.settings.style == 'product' and section.settings.stat_badge_text != blank %}
        <div class="lp-hero__stat-badge">
          {% if section.settings.stat_gif_url != blank %}
            <img class="lp-hero__stat-gif" src="{{ section.settings.stat_gif_url }}" alt="" aria-hidden="true" loading="lazy">
          {% endif %}
          <span>{{ section.settings.stat_badge_text | escape }}</span>
          <span class="lp-hero__stat-icons" aria-hidden="true">
            {% if section.settings.stat_icon_1_url != blank %}<img src="{{ section.settings.stat_icon_1_url }}" alt="" loading="lazy">{% endif %}
            {% if section.settings.stat_icon_2_url != blank %}<img src="{{ section.settings.stat_icon_2_url }}" alt="" loading="lazy">{% endif %}
          </span>
        </div>
      {% endif %}

      {% if section.settings.style == 'product' %}
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' %}
            <figure class="lp-hero__testimonial" {{ block.shopify_attributes }}>
              {% if block.settings.avatar != blank %}
                {{ block.settings.avatar | image_url: width: 192 | image_tag: class: 'lp-hero__avatar', widths: '96, 192', sizes: '48px', loading: 'lazy', alt: block.settings.author }}
              {% elsif block.settings.avatar_url != blank %}
                <img class="lp-hero__avatar" src="{{ block.settings.avatar_url }}" alt="{{ block.settings.author | escape }}" loading="lazy">
              {% endif %}
              <blockquote class="rte">{{ block.settings.quote }}</blockquote>
              {% if block.settings.author != blank %}<figcaption>{{ block.settings.author | escape }}</figcaption>{% endif %}
            </figure>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP hero",
  "tag": "section",
  "class": "lp-hero__wrapper",
  "settings": [
    { "type": "select", "id": "style", "label": "Hero style", "default": "product", "options": [{ "value": "product", "label": "Product" }, { "value": "founder", "label": "Founder story" }] },
    { "type": "text", "id": "badge_text", "label": "Review badge text", "default": "4.8 stars from 12,322+ reviewers" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The <em>Science-Backed Vitamin</em> for Grumpy, Tired, or Unfocused Teens" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>The only bio-matched multivitamin <strong>formulated specifically for teenagers</strong> with 12 nutrients &amp; 21 superfoods to support mood regulation, immunity, and growing bones.</p>" },
    { "type": "richtext", "id": "closing_text", "label": "Closing text" },
    { "type": "richtext", "id": "closing_text_2", "label": "Second closing text" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Unlock Better Nutrition 🍊💊" },
    { "type": "text", "id": "cta_link", "label": "CTA link (URL or #anchor)", "default": "#standalone-product-section" },
    { "type": "text", "id": "guarantee_text", "label": "Guarantee text", "default": "Exclusive First Day 45 Day Money Back Guarantee**" },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "text", "id": "image_url", "label": "Desktop image URL", "default": "//firstday.com/cdn/shop/files/tdk-bts-clean-landsscapre-brady-bunch.jpg?v=1784071376&width=800" },
    { "type": "text", "id": "image_alt", "label": "Desktop image alt text", "default": "Hero image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "text", "id": "image_mobile_url", "label": "Mobile image URL", "default": "//firstday.com/cdn/shop/files/tdk-bts-clean-square-brady-bunch.jpg?v=1784071375&width=1000" },
    { "type": "text", "id": "image_mobile_alt", "label": "Mobile image alt text", "default": "Hero image" },
    { "type": "select", "id": "image_position", "label": "Desktop image position", "default": "right", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "text", "id": "stat_badge_text", "label": "Sales badge text", "default": "6,646 Gummies Sold Every 24h" },
    { "type": "text", "id": "stat_gif_url", "label": "Sales badge GIF URL", "default": "//firstday.com/cdn/shop/files/ebce1fea9a768a63cc6c95d28e1efa8e9818e9db.gif?v=1775682044&width=48" },
    { "type": "text", "id": "stat_icon_1_url", "label": "Sales badge icon 1 URL", "default": "//firstday.com/cdn/shop/files/gummy-orange-2.png?v=1775682044&width=100" },
    { "type": "text", "id": "stat_icon_2_url", "label": "Sales badge icon 2 URL", "default": "//firstday.com/cdn/shop/files/gummy-orange.png?v=1775682044&width=100" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 32 },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID" }
  ],
  "blocks": [
    { "type": "testimonial", "name": "Testimonial", "limit": 2, "settings": [
      { "type": "richtext", "id": "quote", "label": "Quote" },
      { "type": "text", "id": "author", "label": "Author" },
      { "type": "image_picker", "id": "avatar", "label": "Avatar" },
      { "type": "text", "id": "avatar_url", "label": "Avatar URL" }
    ] },
    { "type": "stat_card", "name": "Statistic card", "limit": 4, "settings": [
      { "type": "text", "id": "line_1", "label": "First line" },
      { "type": "text", "id": "value", "label": "Highlighted value" },
      { "type": "text", "id": "line_2", "label": "Second line" },
      { "type": "text", "id": "line_3", "label": "Third line" }
    ] }
  ],
  "presets": [
    { "name": "LP Hero — product", "settings": { "style": "product" } },
    { "name": "LP Hero — founder story", "settings": { "style": "founder", "heading": "1 in 3 Families Have A Nutrient Deficiency.", "cta_label": "Try Now" } }
  ]
}
{% endschema %}
