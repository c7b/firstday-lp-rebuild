{{ 'lp-hero.css' | asset_url | stylesheet_tag }}

{% liquid
  assign media_loading = 'lazy'
  if section.settings.style == 'product'
    assign media_loading = 'eager'
  endif
%}

<section
  id="{{ section.settings.anchor_id | default: section.id }}"
  class="lp-hero__section lp-hero__section--{{ section.settings.style }} lp-hero__section--image-{{ section.settings.image_position }} color-{{ section.settings.color_scheme }} gradient"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;{% if section.settings.highlight_color != blank %} --lp-hero-highlight: {{ section.settings.highlight_color }};{% endif %}"
>
  <div class="lp-hero__container">
    <div class="lp-hero__content">
      <div class="lp-hero__copy">
      {% if section.settings.style == 'product' %}
        {% if section.settings.badge_text != blank %}
          <div class="lp-hero__badge" aria-label="{{ section.settings.badge_text | escape }}">
            <span class="lp-hero__stars" aria-hidden="true">
              {% for star in (1..5) %}
                <svg viewBox="0 0 20 20" focusable="false"><path d="m10 1.5 2.6 5.3 5.9.9-4.3 4.2 1 5.9-5.2-2.8-5.2 2.8 1-5.9-4.3-4.2 5.9-.9Z" /></svg>
              {% endfor %}
            </span>
            <span>{{ section.settings.badge_text | escape }}</span>
          </div>
        {% endif %}
        <h1 class="lp-hero__heading">{{ section.settings.heading }}</h1>
        {% if section.settings.subheading != blank %}
          <div class="lp-hero__subheading rte">{{ section.settings.subheading }}</div>
        {% endif %}
      {% else %}
        <h2 class="lp-hero__heading">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <div class="lp-hero__subheading rte">{{ section.settings.subheading }}</div>
        {% endif %}
        {% assign highlight_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'highlight' %}
            {% assign highlight_count = highlight_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if highlight_count > 0 %}
          <ul class="lp-hero__highlights">
            {% for block in section.blocks %}
              {% if block.type == 'highlight' %}
                <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
        {% if section.settings.closing_text != blank %}
          <div class="lp-hero__closing rte">{{ section.settings.closing_text }}</div>
        {% endif %}
        {% if section.settings.closing_text_2 != blank %}
          <div class="lp-hero__closing rte">{{ section.settings.closing_text_2 }}</div>
        {% endif %}
      {% endif %}
      </div>

      <div class="lp-hero__actions">
        {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
          <a class="lp-hero__cta" href="{{ section.settings.cta_link }}" data-lp-cta>{{ section.settings.cta_label | escape }}</a>
        {% endif %}
        {% if section.settings.style == 'product' and section.settings.guarantee_text != blank %}
          {%- comment -%} Card outline, traced from the reference's own guarantee row. {%- endcomment -%}
          <p class="lp-hero__guarantee">
            <svg class="lp-hero__guarantee-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
            </svg>
            <span>{{ section.settings.guarantee_text | escape }}</span>
          </p>
        {% endif %}
      </div>

      {%- comment -%}
        Social proof sits in normal flow under the CTA — same as the original. It used to be
        absolutely positioned over the media, where the badge and the testimonial collided.
      {%- endcomment -%}
      {% if section.settings.style == 'product' %}
        <div class="lp-hero__proof">
          {% if section.settings.stat_badge_text != blank %}
            <div class="lp-hero__stat-badge">
              {% if section.settings.stat_gif != blank %}
                {{ section.settings.stat_gif | image_url: width: 48 | image_tag: class: 'lp-hero__stat-gif', widths: '24, 48', sizes: '24px', loading: 'lazy', alt: section.settings.stat_gif.alt }}
              {% endif %}
              <span>{{ section.settings.stat_badge_text | escape }}</span>
              <span class="lp-hero__stat-icons" aria-hidden="true">
                {% if section.settings.stat_icon_1 != blank %}{{ section.settings.stat_icon_1 | image_url: width: 52 | image_tag: widths: '26, 52', sizes: '26px', loading: 'lazy', alt: section.settings.stat_icon_1.alt }}{% endif %}
                {% if section.settings.stat_icon_2 != blank %}{{ section.settings.stat_icon_2 | image_url: width: 52 | image_tag: widths: '26, 52', sizes: '26px', loading: 'lazy', alt: section.settings.stat_icon_2.alt }}{% endif %}
              </span>
            </div>
          {% endif %}

          {% for block in section.blocks %}
            {% if block.type == 'testimonial' %}
              <figure class="lp-hero__testimonial" {{ block.shopify_attributes }}>
                {% if block.settings.avatar != blank %}
                  {{ block.settings.avatar | image_url: width: 192 | image_tag: class: 'lp-hero__avatar', widths: '96, 192', sizes: '48px', loading: 'lazy', alt: block.settings.avatar.alt }}
                {% endif %}
                <blockquote class="rte">{{ block.settings.quote }}</blockquote>
                {%- comment -%}
                  The reference closes this card with one footer row: the name and its verified
                  mark on the left, the rating on the right. Ours put the name on its own line
                  and carried no rating at all, which read as a different component rather than
                  the same one styled differently.
                {%- endcomment -%}
                {% if block.settings.author != blank %}
                  {%- assign star_count = block.settings.rating | default: 5 -%}
                  <figcaption>
                    <span class="lp-hero__testimonial-author">
                      {{- block.settings.author | escape -}}
                      <svg class="lp-hero__testimonial-verified" viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" focusable="false">
                        <circle cx="10" cy="10" r="10" fill="#486ced"/>
                        <path d="m5.6 10.2 2.9 2.9 5.9-6.2" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="lp-hero__testimonial-stars" role="img" aria-label="{{ star_count }} out of 5">
                      {%- for i in (1..5) -%}
                        <svg viewBox="0 0 20 19" width="12" height="12" aria-hidden="true" focusable="false">
                          <path d="M10 0l2.6 6.2 6.7.5-5.1 4.4 1.6 6.5L10 14.2 4.2 17.6l1.6-6.5L.7 6.7l6.7-.5z" fill="{% if i <= star_count %}#1a1a1a{% else %}#c9c9c9{% endif %}"/>
                        </svg>
                      {%- endfor -%}
                    </span>
                  </figcaption>
                {% endif %}
              </figure>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="lp-hero__media">
      <picture>
        {% if section.settings.image_mobile != blank %}
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 1000 }}">
        {% endif %}
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'lp-hero__image', widths: '375, 550, 750, 1000, 1600', sizes: '(min-width: 750px) 50vw, 100vw', loading: media_loading, alt: section.settings.image.alt }}
        {% endif %}
      </picture>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP hero",
  "tag": "section",
  "class": "lp-hero__wrapper",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Hero style",
      "default": "product",
      "options": [
        {
          "value": "product",
          "label": "Product"
        },
        {
          "value": "founder",
          "label": "Founder story"
        }
      ]
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Review badge text",
      "default": "4.8 stars from 12,322+ reviewers",
      "visible_if": "{{ section.settings.style == 'product' }}"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The <em>Science-Backed Vitamin</em> for Grumpy, Tired, or Unfocused Teens"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>The only bio-matched multivitamin <strong>formulated specifically for teenagers</strong> with 12 nutrients &amp; 21 superfoods to support mood regulation, immunity, and growing bones.</p>"
    },
    {
      "type": "richtext",
      "id": "closing_text",
      "label": "Closing text",
      "visible_if": "{{ section.settings.style == 'founder' }}"
    },
    {
      "type": "richtext",
      "id": "closing_text_2",
      "label": "Second closing text",
      "visible_if": "{{ section.settings.style == 'founder' }}"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Unlock Better Nutrition 🍊💊"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "CTA link (URL or #anchor)",
      "default": "#standalone-product-section"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "Exclusive First Day 45 Day Money Back Guarantee**",
      "visible_if": "{{ section.settings.style == 'product' }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "text",
      "id": "stat_badge_text",
      "label": "Sales badge text",
      "default": "6,646 Gummies Sold Every 24h",
      "visible_if": "{{ section.settings.style == 'product' }}"
    },
    {
      "type": "image_picker",
      "id": "stat_gif",
      "label": "Sales badge GIF",
      "visible_if": "{{ section.settings.style == 'product' }}"
    },
    {
      "type": "image_picker",
      "id": "stat_icon_1",
      "label": "Sales badge icon 1",
      "visible_if": "{{ section.settings.style == 'product' }}"
    },
    {
      "type": "image_picker",
      "id": "stat_icon_2",
      "label": "Sales badge icon 2",
      "visible_if": "{{ section.settings.style == 'product' }}"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "info": "Colors the emphasised words in the heading and founder highlights",
      "default": "#486ced"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets other sections link here, e.g. a CTA pointing at #standalone-product-section. Leave empty unless something links to this section."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 2,
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "info": "Drawn as filled stars on the card's bottom row, next to the name."
        }
      ]
    },
    {
      "type": "highlight",
      "name": "Founder highlight",
      "limit": 6,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP Hero — product",
      "settings": {
        "style": "product"
      }
    },
    {
      "name": "LP Hero — founder story",
      "settings": {
        "style": "founder",
        "heading": "1 in 3 Families Have A Nutrient Deficiency.",
        "cta_label": "Try Now"
      }
    }
  ],
  "enabled_on": {
    "templates": [
      "page",
      "index",
      "product"
    ]
  }
}
{% endschema %}
