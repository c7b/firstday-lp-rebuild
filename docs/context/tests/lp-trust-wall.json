{
  "section": "lp-trust-wall",
  "notes": "Masonry trust wall with three real, user-started testimonial videos. Each poster has a custom play button backed by a native controlled video, not a decorative badge.",
  "assertions": [
    {
      "id": "exact-original-video-metadata",
      "type": "video-metadata",
      "selector": ".lp-trust-wall__media-video[data-trust-video]",
      "expected_sources": [
        "https://cdn.shopify.com/videos/c/o/v/aecd515a10d444158c4daf44fa5763f6.mov",
        "https://cdn.shopify.com/videos/c/o/v/37827354069a403e9ad7a5b203afe326.mp4",
        "https://cdn.shopify.com/videos/c/o/v/254cebfaf76545bbaf344675fd8c13bc.mp4"
      ],
      "expected_poster_fragments": [
        "phils-my-pharmacist.png",
        "review-woman.png",
        "review-woman-2.png"
      ],
      "why": "The exact three distinct source URLs and matching distinct posters must be the ones recovered from the original storefront."
    },
    {
      "id": "three-play-buttons-work",
      "type": "video-play-buttons",
      "selector": ".lp-trust-wall__play-button[data-trust-video-play]",
      "video_selector": ".lp-trust-wall__media-video[data-trust-video]",
      "equals": 3,
      "why": "Clicking every visible play button must start and advance its corresponding video."
    },
    {
      "id": "native-controls-remain-available",
      "type": "count",
      "selector": ".lp-trust-wall__media-video[controls][playsinline][poster]",
      "equals": 3,
      "why": "After the poster overlay disappears, native playback controls keep pause, seek, volume, and captions affordances usable."
    },
    {
      "id": "dr-lei-accessible-video-label",
      "type": "count",
      "selector": "[data-trust-video-play][aria-label=\"Play Dr. Lei Chen testimonial video\"]",
      "equals": 1,
      "why": "Dr. Lei's play button has one unique screen-reader label."
    },
    {
      "id": "diana-accessible-video-label",
      "type": "count",
      "selector": "[data-trust-video-play][aria-label=\"Play Diana V. testimonial video\"]",
      "equals": 1,
      "why": "Diana's play button has one unique screen-reader label."
    },
    {
      "id": "dr-ed-accessible-video-label",
      "type": "count",
      "selector": "[data-trust-video-play][aria-label=\"Play Dr. Ed Giovannucci testimonial video\"]",
      "equals": 1,
      "why": "Dr. Ed's play button has one unique screen-reader label."
    }
  ]
}
